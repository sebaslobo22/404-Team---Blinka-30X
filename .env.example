# Copia este archivo a .env y completa los valores. NUNCA subas .env.
# Las claves viven solo en variables de entorno. Sin prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# replay = usa extracciones guardadas (demo publico). live = llama a la API.
EXTRACTION_MODE=replay

# Despliegue PUBLICO (el enlace del jurado): pon MODO_PUBLICO=1 y ninguna otra variable. Con esto /team, /api/team y /equipo
# responden 404 y no se crea ningun cliente de Supabase. En el proyecto interno, dejalo vacio.
MODO_PUBLICO=

# Centro de mando (/team). Sin estas variables la página muestra la semilla en solo lectura.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# PIN compartido del equipo para escribir en /team (web y scripts/equipo.mjs). Solo en el servidor.
# Obligatorio de 16 o mas caracteres (recomendado 20+, aleatorio, de un gestor de contrasenas); mas corto no deja entrar a nadie.
EQUIPO_PIN=
# Para scripts/equipo.mjs
EQUIPO_URL=https://404team.vercel.app
EQUIPO_QUIEN=
# Cadena de conexión de Postgres (Supabase → Project Settings → Database → URI). Solo para scripts/migrar.mjs.
SUPABASE_DB_URL=

# Bot de Telegram de Pulso (/api/telegram). Solo en el servidor, sin prefijo NEXT_PUBLIC_. Ver README, "Bot de Telegram".
# Token que entrega @BotFather.
TELEGRAM_BOT_TOKEN=
# Secreto del webhook (16 a 256 caracteres: letras, numeros, _ y -). Sin el, el endpoint rechaza todo.
TELEGRAM_WEBHOOK_SECRET=
# Id numerico de Telegram de quien aprueba lo escalado (el dueno de Aurora Cloud). Sin el, nadie puede aprobar.
TELEGRAM_DUENO_ID=
# Tope global de facturas por dia (default 100). El limite por chat es fijo: 5 por hora.
TELEGRAM_TOPE_DIARIO=
# URL base publica del producto, para el enlace en las respuestas (default https://equipo404.produfy.co).
PULSO_URL_PUBLICA=
# El bot tambien usa OPENROUTER_API_KEY (arriba), NEXT_PUBLIC_SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.

# Subida web en vivo (/probar). Apagada salvo LECTURA_EN_VIVO=1 con OPENROUTER_API_KEY. Nunca en el enlace del jurado sin
# un limite de credito en la clave de OpenRouter: los topes de abajo viven en memoria y no son el techo de gasto.
LECTURA_EN_VIVO=
VIVO_POR_VISITANTE_HORA=
VIVO_GLOBAL_DIA=

# Canal Gmail (integraciones/gmail). Apagado si el secreto falta o tiene menos de 24 caracteres. El mismo valor va en la
# propiedad PULSO_SECRETO del script de Apps Script del buzon del equipo. Fija antes un limite de credito en OpenRouter.
GMAIL_CANAL_SECRETO=
GMAIL_POR_REMITENTE_HORA=
GMAIL_GLOBAL_DIA=

# Bienvenida web (app/bienvenida): enlaces publicos de los canales. Se fijan al construir. Si faltan, la tarjeta
# dice "Pidele el enlace al equipo" en vez de mostrar un enlace roto. Telegram solo acepta https (p. ej. https://t.me/...).
NEXT_PUBLIC_TELEGRAM_BOT_URL=
NEXT_PUBLIC_GMAIL_BUZON=
